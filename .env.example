# Développement local : PostgreSQL embarqué dans ./data/postgres
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# npm start : site et API sur la même origine. npm run dev utilise automatiquement 5173.
APP_ORIGIN=http://localhost:3001
DATA_DIR=./data
# Production : PostgreSQL externe obligatoire, avec TLS configuré par l'hébergeur.
# DATABASE_URL=postgresql://user:password@localhost:5432/monmiammiam
# PGSSL=true
# TRUST_PROXY=1
# Paiements : démo locale par défaut. Sur Render, utiliser disabled avant la recette EasyPay.
PAYMENT_MODE=demo
# Nécessaire uniquement au premier peuplement de démonstration (>= 10 caractères).
# DEMO_PASSWORD=choisir-un-mot-de-passe

# EasyPay (côté serveur seulement, ne jamais utiliser de préfixe VITE_).
# Modes : disabled | demo (local seulement) | easypay-sandbox | easypay-live
# EASYPAY_TOKEN=
# EASYPAY_CORRELATION_ID=
# EASYPAY_RESTAURANT_ID=mon-miam-miam-kinshasa
# IPN à déclarer dans l’espace marchand après déploiement :
# https://VOTRE-SERVICE.onrender.com/api/payments/easypay/ipn
# Render : APP_ORIGIN peut être omis ; RENDER_EXTERNAL_URL est utilisé automatiquement.
# E-mails de récupération : service autorisé, clés privées sur Render uniquement.
# RESEND_API_KEY=
# MAIL_FROM=merdi.tshinyama@2030.ulc-icam.com
# MAIL_REPLY_TO=merdi.tshinyama@2030.ulc-icam.com
# Sans domaine Resend vérifié : MAIL_FROM=onboarding@resend.dev et destinataire limité.
# MAIL_TEST_RECIPIENT=merdi.tshinyama@2030.ulc-icam.com
# Aperçus fictifs des réponses à côté d’EasyPay : aucun changement de statut réel.
# DEMO_PREVIEW=true
